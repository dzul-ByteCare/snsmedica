{% set title = content.field_title.0 %}
{% set body = content.field_content.0 %}
{% set bg_image = content.field_bg_img.0 %}
{% set bg_color = content.field_bg_color.0 %}

{% if title %}
	<h3>{{ title }}</h3>
{% endif %}

{% if body %}
	<div class="content">{{ body }}</div>
{% endif %}

<div class="steps-items" id="steps-{{ paragraph.id() }}">
	<div class="row justify-content-between">
		{% for key, item in content.field_items_img_list_w_desc if key|first != '#' %}
			<div class="col-12 col-md-6 col-lg-4 {{ key is odd ? 'offset-lg-4 ' }}mb-4">
				<div class="title with-icon">
					{% if item['#paragraph'].field_image.entity.fileuri %}
          <div class="image">
            <img src="{{ file_url(item['#paragraph'].field_image.entity.fileuri) }}" alt="{{ item['#paragraph'].field_image.get(0).alt }}" class="img-fluid">
          </div>
          {% endif %}
					<div class="title">{{ item['#paragraph'].field_title.value }}</div>
				</div>
				<div class="desc">
					{{ item['#paragraph'].field_description.value|raw }}
				</div>
			</div>	
		{% endfor %}
	</div>
</div>


<style type="text/css">
	{% if bg_color %}
		#product-steps { background: {{ bg_color }}; }
	{% endif %}
	{% if bg_image %}
		#steps-{{ paragraph.id() }} { 
			background-image: url('{{ file_url(bg_image["#item"].entity.uri.value) }}');
			background-position: center; 
			background-repeat:no-repeat; 
		}
	{% endif %}
</style>
