{% set image = content.field_image.0 %}
{% set tabAccorItem = content.field_tab_accordion_item %}

<div id="faq-{{ paragraph.id() }}">
	<div class="row">
		<div class="col-12 col-md-6">
			<div class="accordion" id="accordion_{{ paragraph.id() }}">
			  {% for key, item in tabAccorItem if key|first != '#' %}
			    {% set paraTitle = item['#paragraph'].field_tab_title.value %}
			    {% set paraContent = item['#paragraph'].field_content.value %}
			    {% set paraImg = item['#paragraph'].field_image.entity.fileuri %}
			    {% set paraLink = item['#paragraph'].field_link.get(0).getUrl().toString() %}

			    {% if paraContent or paraImg or paraLink %}
			    <div class="accordion-item">
			      <div id="heading_{{ paragraph.id() }}_{{key}}" class="accordion-header">
			        <button class="accordion-button{{ not loop.first ? ' collapsed' }}" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_{{ paragraph.id() }}_{{key}}" aria-expanded="{{ loop.first ? 'true' : 'false' }}" aria-controls="collapse_{{ paragraph.id() }}_{{key}}">{{ paraTitle }}</button>
			      </div>
			      <div id="collapse_{{ paragraph.id() }}_{{key}}" class="accordion-collapse collapse{{ loop.first ? ' show' }}" aria-labelledby="heading_{{ paragraph.id() }}_{{key}}" data-bs-parent="#accordion_{{ paragraph.id() }}">
			        <div class="accordion-body">
			          <div class="row">

			            {% if (paraContent and paraImg is empty) or (paraContent is empty and paraImg) %}
			              {% set column_class = 'col-12' %}
			            {% elseif paraContent and paraImg %}
			              {% set column_class = 'col-md-6' %}
			            {% endif %}
			            
			            {# < Image > #}
			            {% if paraImg %}
			            <div class="{{ column_class }}">
			              <div class="accordion-img">
			                <img src="{{ file_url(paraImg) }}" alt="{{ item['#paragraph'].field_image_only.get(0).alt }}" class="img-fluid">
			              </div>
			            </div>
			            {% endif %}
			            {# < / Image > #}

			            {# < Body > #}
			            {% if paraContent %}
			            <div class="{{ column_class }}">
			              <div class="accordion-inner">
			                {{ paraContent|raw }}
			              </div>
			            </div>
			            {% endif %}
			            {# < / Body > #}

			            {# < Link > #}
			            {% if paraLink %}
			            <div class="col-12">
			            {% include directory ~ '/templates/paragraphs/component/paragraph_inner-field_link.html.twig' %}
			            </div>
			            {% endif %}
			            {# < / Link > #}

			          </div>
			        </div>
			      </div>
			    </div>
			    {% endif %}
			  {% endfor %}
			</div>
		</div>
		{# cols #}
		<div class="col-12 col-md-6">
			<div class="faq-img">{{ image ? image : '<img src="/sites/default/files/faq-default.png" alt="faq-default.png">' }}</div>
			
		</div>
	</div>
</div>

